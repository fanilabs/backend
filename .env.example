# Copy to .env and fill in real values for local development.
# See src/shared/config/env.ts for the full validated schema — this file
# must stay in sync with it.

NODE_ENV=development
LOG_LEVEL=info

HOST=0.0.0.0
PORT=3000

# docker-compose service name "postgres"; use localhost if running outside Docker
DATABASE_URL=postgresql://fanilab:fanilab@localhost:5432/fanilab_backend?schema=public

# docker-compose service name "redis"; use localhost if running outside Docker
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-random-64-char-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-char-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Matches FaniLab-SmartContract/.env.example — keep these two repos' network
# configuration in sync when deploying to a new network.
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed contract IDs (from FaniLab-SmartContract deployment output).
# Leave unset in early local development — modules that need them will
# fail fast with a clear error rather than silently no-op.
ESCROW_CONTRACT_ID=
DELIVERY_CONTRACT_ID=
DISPUTE_RESOLUTION_CONTRACT_ID=
FLEET_MANAGEMENT_CONTRACT_ID=
IDENTITY_REPUTATION_CONTRACT_ID=
SETTLEMENT_CONTRACT_ID=

INDEXER_POLL_INTERVAL_MS=5000
INDEXER_LAG_ALERT_LEDGERS=50

# Local-filesystem root for dispute evidence files (docs/API_REFERENCE.md).
EVIDENCE_STORAGE_DIR=./storage/evidence

# Maximum size in bytes for evidence file uploads (docs/API_REFERENCE.md).
# Base64-encoded payloads are ~33% larger, so actual file limit is ~75% of this.
EVIDENCE_MAX_BYTES=10485760
